# Copiar a .env, o dejar que `make init` lo genere. NUNCA commitear .env.
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_API_TOKEN=local-dev-token
RAG_DEFAULT_MODEL=agente-rag-sonnet

# --- Temas (perfiles) --------------------------------------------------------
# Cada tema es un `profiles/<slug>.yaml`: sus reglas, su corpus y su troceado.
# El despliegue sirve todos a la vez; el cliente elige con `X-Rag-Profile`.
RAG_PROFILES_DIR=profiles
# Tema usado cuando la petición no manda cabecera. Vacío = el primero por orden
# alfabético de archivo.
RAG_DEFAULT_PROFILE=

# Backends: local/stub no tocan AWS y sirven para desarrollar sin gastar.
RAG_RETRIEVAL_BACKEND=local          # local | bedrock
RAG_INFERENCE_BACKEND=stub           # stub  | bedrock

# Corpus para la recuperación local. Vacío = el que declare cada perfil, que es
# lo normal. Darle valor lo fuerza para TODOS los perfiles: existe para apuntar
# el servicio a un corpus concreto (una evaluación, reproducir un fallo).
RAG_CORPUS_DIR=

# AWS (solo con backends bedrock)
RAG_AWS_PROFILE=default
RAG_AWS_REGION=us-east-1
# Mapa slug → ID de Knowledge Base (JSON). Lo inyecta Terraform en el
# despliegue; en local no hace falta.
# RAG_PROFILE_KNOWLEDGE_BASES={"coches":"XXXXXXXXXX"}
RAG_GUARDRAIL_ID=

# Mapa de alias → ID de Bedrock (JSON). El cliente nunca envía IDs.
# Los modelos de Anthropic se invocan por PERFIL DE INFERENCIA (us. / global.):
# el ID base responde "on-demand throughput isn't supported".
# RAG_MODEL_ALIASES={"agente-rag-sonnet":"us.anthropic.claude-sonnet-5"}
#
# Qué alias acepta `temperature`. Sonnet 5 la dejó deprecada y Bedrock
# responde ValidationException; Haiku 4.5 y la familia GPT sí la aceptan.
# RAG_MODEL_SAMPLING={"agente-rag-sonnet":false,"agente-rag-haiku":true}
