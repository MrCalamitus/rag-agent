# Copiar a .env para desarrollo local. NUNCA commitear .env.
LUISCV_ENVIRONMENT=local
LUISCV_LOG_LEVEL=INFO
LUISCV_API_TOKEN=local-dev-token

# Backends: local/stub mientras la ingesta del RAG está pendiente.
LUISCV_RETRIEVAL_BACKEND=local          # local | bedrock
LUISCV_INFERENCE_BACKEND=stub           # stub  | bedrock
LUISCV_CORPUS_DIR=corpus

# AWS (solo con backends bedrock)
LUISCV_AWS_PROFILE=luis
LUISCV_AWS_REGION=us-east-1
LUISCV_KNOWLEDGE_BASE_ID=
LUISCV_GUARDRAIL_ID=

# Mapa de alias → ID de Bedrock (JSON). El cliente nunca envía IDs.
# Los modelos de Anthropic se invocan por PERFIL DE INFERENCIA (us. / global.):
# el ID base responde "on-demand throughput isn't supported".
# LUISCV_MODEL_ALIASES={"agente-rag-sonnet":"us.anthropic.claude-sonnet-5"}
#
# Qué alias acepta `temperature`. Sonnet 5 la dejó deprecada y Bedrock
# responde ValidationException; Haiku 4.5 y la familia GPT sí la aceptan.
# LUISCV_MODEL_SAMPLING={"agente-rag-sonnet":false,"agente-rag-haiku":true}
