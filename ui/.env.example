# Copiar a `ui/.env`. NINGUNA de estas variables lleva prefijo `PUBLIC_`:
# ninguna debe llegar al navegador. El token, sobre todo.

# Dónde escucha el agente. En local, lo que levanta `make run` en la raíz.
RAG_API_BASE_URL=http://localhost:8080

# El mismo `RAG_API_TOKEN` del servicio.
RAG_API_TOKEN=local-dev-token

# EL TEMA. Una instancia de esta UI sirve un solo perfil, y este es el punto
# donde se fija. Debe existir en `profiles/<slug>.yaml` del servicio; si no,
# la página lo dice al arrancar en vez de fallar pregunta a pregunta.
RAG_PROFILE=autos

# Alias del modelo (nunca un ID de Bedrock). Opcional.
RAG_MODEL=agente-rag-sonnet

# Copy de la portada. Vacío = se toman del propio perfil (`name` y `subject`).
UI_TITLE=
UI_INTRO=

# Cuántos turnos previos se reenvían. La API no guarda estado (`store: false`,
# sin `previous_response_id`), así que el historial lo lleva el cliente.
UI_MAX_HISTORY_TURNS=8
